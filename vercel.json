{
  "version": 2,
  "builds": [
    {
      "src": "Nexus-main/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "nexus-backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/nexus-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Nexus-main/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ]
}